# Copy to .env and fill (never commit .env)
NODE_ENV=development
JWT_SECRET=dev-only-change-me-before-prod
JWT_EXPIRES=7d
PORT=4000
CORS_ORIGINS=*
RATE_MAX=300
RATE_WINDOW_MS=60000
NEXT_PUBLIC_API=http://localhost:4000
# Prod:
# NODE_ENV=production
# JWT_SECRET=<64-char-random>
# CORS_ORIGINS=https://lms-mis.du.ac.bd
# NEXT_PUBLIC_API=https://lms-mis.du.ac.bd/api
# DATABASE_URL=postgresql://mis:<POSTGRES_PASSWORD>@postgres:5432/mislms
# POSTGRES_PASSWORD=<strong>
# Render: DATABASE_URL comes from the Render Postgres instance (see docs/RENDER.md).
