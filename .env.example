# Copy to .env and fill values. Never commit .env or real secrets.
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET=dev-only-change-me-before-production-32-chars-minimum
JWT_EXPIRES=7d
SESSION_TTL_HOURS=168
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3101
TRUST_PROXY=0
JSON_LIMIT=2mb

# Rate limiting
RATE_MAX=300
RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
AI_RATE_MAX=20

# Safe defaults: risky or unfinished features stay off until explicitly enabled.
ALLOW_PUBLIC_REGISTRATION=false
FEATURES_SEARCH=true
FEATURES_REALTIME=true
WORKERS_INLINE=true
EVENTS_INLINE=true
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20

# AI assistant (read-only). Disabled by default; mock is fully local.
AI_ENABLED=false
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=mock-1
AI_EMBEDDING_MODEL=hash-384
AI_EMBEDDING_DIM=384
AI_FALLBACK_TO_MOCK=true
AI_DAILY_REQUESTS=100
AI_DAILY_BUDGET_USD=1
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=700
AI_TIMEOUT_MS=20000
AI_CHUNK_SIZE=900
AI_CHUNK_OVERLAP=120
AI_RETRIEVAL_LIMIT=6

# Optional: /metrics is public in development when unset. Set a long random
# value in production and send it as X-Metrics-Token or a bearer token.
METRICS_TOKEN=

# Web
NEXT_PUBLIC_API=http://localhost:4000

# Production notes:
# - Use a random JWT_SECRET of at least 32 characters.
# - Set CORS_ORIGINS to the exact web origin(s), never *.
# - Set METRICS_TOKEN and restrict /metrics at the edge if possible.
# - Keep AI_ENABLED=false until a provider is configured and reviewed.
# - Never run destructive schema commands against the production database.
# - See docs/2.0/SECURITY.md and docs/2.0/DEPLOYMENT.md.
